extends Node

func _ready() -> void:
	GameManager.start_new_game("standard")
	ActionQueueManager.clear()
	var planner = preload("res://scripts/core/GoalQueuePlanner.gd")
	var goal := {"kind": "recipe", "id": "smithing:smith_bronze_scimitar"}
	var draft: Dictionary = planner.build(goal)
	assert(draft.errors.is_empty(), str(draft.errors))
	assert(draft.steps.size() >= 4)
	assert(str(draft.steps[-1].action_id) == "smith_bronze_scimitar")
	assert(ActionQueueManager.is_empty())
	var two: Dictionary = planner.build({"kind":"recipe", "id":"smithing:smith_bronze_scimitar", "target_quantity":2})
	assert(two.errors.is_empty() and int(two.steps[-1].target) == 2)
	assert(int(two.steps[0].target) == 4 and int(two.steps[1].target) == 4)
	var random_plan: Dictionary = planner.build({"kind":"item", "id":"bronze_arrowtips", "level": 5}, {"bronze_arrowtips":"smithing:smelt_bronze_bar"})
	assert(not random_plan.warnings.is_empty())
	assert(ActionQueueManager.is_empty())
	var queue_panel := preload("res://scripts/ui/panels/ActionQueuePanel.gd").new()
	add_child(queue_panel)
	queue_panel.focus_route({"screen": Screens.ACTION_QUEUE, "plan_goal": goal})
	assert(ActionQueueManager.is_empty() and not queue_panel._plan.steps.is_empty())
	var target_controls: Array[Node] = queue_panel._plan_box.find_children("*", "SpinBox", true, false)
	assert(not target_controls.is_empty())
	(target_controls[0] as SpinBox).value = 2
	assert(int(queue_panel._plan.target) == 2 and int(queue_panel._plan.steps[-1].target) == 2)
	queue_panel.focus_route({"screen": Screens.ACTION_QUEUE, "plan_goal": goal})
	var original_first: Dictionary = queue_panel._plan.steps[0].duplicate()
	var original_second: Dictionary = queue_panel._plan.steps[1].duplicate()
	var buttons: Array[Node] = queue_panel._plan_box.find_children("*", "Button", true, false)
	var down: Button = null
	for button in buttons:
		if (button as Button).text == "Down": down = button; break
	assert(down != null)
	down.pressed.emit()
	assert(str(queue_panel._plan.steps[0].action_id) == str(original_second.action_id))
	assert(str(queue_panel._plan.steps[1].action_id) == str(original_first.action_id))
	queue_panel._recalculate_plan()
	queue_panel._append_plan()
	assert(ActionQueueManager.size() >= 4 and not ActionQueueManager.enabled)
	assert(ActionQueueManager.start())
	OfflineProgression.simulate_synchronously(3600.0)
	assert(BankManager.count_with_variants("bronze_scimitar") >= 1)
	assert(ActionQueueManager.current_index == ActionQueueManager.size())
	ActionQueueManager.clear()
	GameManager.start_new_game("standard")
	BankManager.add_item_guaranteed("copper_ore", 1)
	BankManager.add_item_guaranteed("tin_ore", 1)
	BankManager.add_item_guaranteed("bronze_bar", 1)
	var stocked: Dictionary = planner.build(goal)
	assert(stocked.errors.is_empty())
	assert(stocked.steps.size() == 2 and str(stocked.steps[0].action_id) == "smelt_bronze_bar")
	BankManager.overflow["copper_ore"] = 1
	var overflow_plan: Dictionary = planner.build(goal)
	assert(not overflow_plan.errors.is_empty())
	BankManager.overflow.erase("copper_ore")
	var encyclopedia := preload("res://scripts/ui/panels/EncyclopediaPanel.gd").new()
	add_child(encyclopedia)
	assert(encyclopedia._records("Skills").size() == DataLoader.get_skill_ids().size())
	assert(encyclopedia._records("Items").size() == DataLoader.items.size())
	assert(encyclopedia._records("Activities").size() > 100)
	assert(encyclopedia._records("Monsters").size() == DataLoader.monsters.size())
	assert(TutorialManager.step_count() > 0)
	encyclopedia._set_mode("reference")
	for index in range(encyclopedia.CATEGORIES.size()):
		encyclopedia._category.select(index)
		encyclopedia._rebuild()
		assert(encyclopedia._list.get_child_count() >= 2)
	encyclopedia._category.select(encyclopedia.CATEGORIES.find("Items"))
	encyclopedia._search.text = "bronze scimitar"
	encyclopedia._rebuild()
	assert(str((encyclopedia._list.get_child(0) as Label).text).begins_with("1 results"))
	print("GUIDE PLANNER CHECK PASS")
	get_tree().quit()
