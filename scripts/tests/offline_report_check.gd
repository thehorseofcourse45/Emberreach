extends Node

func _ready() -> void:
	GameManager.start_new_game("standard")
	ActionQueueManager.clear()
	PlayerData.set_level("firemaking", 120)
	PlayerData.set_level("woodcutting", 4)
	PlayerData.add_xp("woodcutting", maxf(0.0, float(XPTable.xp_for_level(5)) - PlayerData.get_xp("woodcutting") - 1.0))
	PlayerData.bump_stat("items_gained", "normal_log", 25)
	PlayerData.bump_stat("actions", "woodcutting:normal_tree", 10)
	BankManager.add_item_guaranteed("normal_log", 1)
	ActionQueueManager.add_skill_step("firemaking", "burn_normal_log", "normal_log", 0)
	ActionQueueManager.add_skill_step("woodcutting", "normal_tree", "normal_log", 5)
	assert(ActionQueueManager.start())
	var result: Dictionary = OfflineProgression.simulate_synchronously(3600.0)
	assert(result.timeline.size() >= 2)
	assert(str(result.timeline[0]).contains("finished") and str(result.timeline[1]).contains("finished"))
	assert(ActionQueueManager.current_index == 2)
	assert(str(result.skill) == "woodcutting" and str(result.action) == "normal_tree")
	assert(not result.ready_tasks.is_empty())
	assert(result.ready_tasks.has("First Firewood"))
	assert(not result.ready_milestones.is_empty())
	assert(not result.level_unlocks.is_empty())
	assert(not Quests.is_claimed("first_firewood"))

	GameManager.start_new_game("standard")
	ActionQueueManager.clear()
	BankManager.add_item_guaranteed("copper_ore", 1)
	BankManager.add_item_guaranteed("tin_ore", 1)
	assert(SkillManager.start_action("smithing", "smelt_bronze_bar", 0))
	result = OfflineProgression.simulate_synchronously(120.0)
	assert(str(result.stopped_reason).contains("out of"))
	assert(str(result.timeline[0]).contains("Stopped:") and str(result.timeline[0]).contains("out of"))
	assert(str(result.skill) == "smithing" and str(result.action) == "smelt_bronze_bar")

	GameManager.start_new_game("standard")
	ActionQueueManager.clear()
	ActionQueueManager.add_skill_step("woodcutting", "normal_tree", "normal_log", 1)
	ActionQueueManager.add_skill_step("smithing", "smelt_bronze_bar", "bronze_bar", 3)
	assert(ActionQueueManager.start())
	result = OfflineProgression.simulate_synchronously(120.0)
	assert(result.timeline.size() >= 2)
	assert(str(result.timeline[0]).contains("Queue step finished"))
	assert(str(result.timeline[1]).contains("Queue paused") and str(result.timeline[1]).contains("Needs"))
	assert(str(result.timeline[1]).contains("Bronze Bar"))
	assert(float(result.cap_excluded_seconds) == 0.0 and float(result.active_unprocessed_seconds) > 0.0)
	assert(not ActionQueueManager.enabled)

	GameManager.start_new_game("standard")
	ActionQueueManager.clear()
	SkillManager.deserialize({"running": true, "active_skill": "smithing", "active_action_id": "smelt_bronze_bar"})
	assert(not SkillManager.running and SkillManager.stop_reason == SkillManager.StopReason.MISSING_MATERIALS)
	result = OfflineProgression.simulate_synchronously(120.0)
	assert(str(result.stopped_reason).contains("Needs") and str(result.timeline[0]).contains("before catch-up"))

	GameManager.start_new_game("standard")
	ActionQueueManager.clear()
	ActionQueueManager.add_skill_step("woodcutting", "normal_tree", "normal_log", 1)
	ActionQueueManager.add_combat_step({"type": "area", "id": "farmlands", "monsters": ["chicken"]})
	assert(ActionQueueManager.start())
	result = OfflineProgression.simulate_synchronously(120.0)
	assert(str(result.timeline[0]).contains("Queue step finished"))
	assert(str(result.timeline[1]).contains("Queue waiting"))
	assert(CombatManager.state == CombatManager.State.IDLE)

	GameManager.start_new_game("standard")
	ActionQueueManager.clear()
	CombatManager.start_combat({"type": "area", "id": "farmlands", "monsters": ["chicken"]})
	assert(CombatManager.state != CombatManager.State.IDLE)
	PlayerData.settings["offline_combat_enabled"] = false
	result = OfflineProgression.simulate_synchronously(120.0)
	assert(float(result.processed_seconds) == 0.0)
	assert(str(result.timeline[0]).contains("combat is disabled"))
	assert(str(result.stopped_reason).contains("disabled"))
	var dialog := preload("res://scripts/ui/OfflineSummaryDialog.gd").new()
	add_child(dialog)
	dialog.show_summary(result)
	assert(dialog.visible)
	dialog.queue_free()

	GameManager.start_new_game("standard")
	ActionQueueManager.clear()
	ActionQueueManager.add_skill_step("smithing", "smelt_bronze_bar", "bronze_bar", 3)
	assert(ActionQueueManager.start())
	assert(not ActionQueueManager.enabled)
	result = OfflineProgression.simulate_synchronously(120.0)
	assert(str(result.timeline[0]).contains("Queue was paused") and str(result.timeline[0]).contains("Needs"))

	GameManager.start_new_game("standard")
	ActionQueueManager.clear()
	PlayerData.settings["offline_cap_hours"] = 1.0
	PlayerData.last_offline_unix = int(Time.get_unix_time_from_system()) - 7200
	OfflineProgression.run_on_load()
	while OfflineProgression.is_running: OfflineProgression._step_chunk()
	result = OfflineProgression.last_summary()
	assert(absf(float(result.cap_excluded_seconds) - 3600.0) < 5.0)
	assert(absf(float(result.active_unprocessed_seconds) + float(result.processed_seconds) - 3600.0) < 5.0)
	var second: Dictionary = OfflineProgression.run_on_load()
	assert(float(second.elapsed_seconds) < 5.0)
	print("OFFLINE REPORT PASS")
	get_tree().quit()
