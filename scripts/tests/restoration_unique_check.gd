extends Node

func _ready() -> void:
	GameManager.start_new_game("standard")
	var id := "ashwood_restore_1"
	assert(not Quests.uses_legacy_campaign_objectives(id))
	assert(Quests.objectives_for(id).size() == 2)
	PlayerData.bump_stat("monsters_killed", "sootfang_fox", 3)
	var old_save := {"accepted": {id:true}, "claimed": {"hearthfall_restore_1":true}}
	Quests.deserialize(old_save)
	assert(Quests.is_claimed("hearthfall_restore_1"))
	assert(Quests.uses_legacy_campaign_objectives(id))
	assert(Quests.progress(id).objectives[0].current == 3)
	var upgraded: Dictionary = Quests.serialize().duplicate(true)
	Quests.deserialize({})
	assert(not Quests.uses_legacy_campaign_objectives(id))
	Quests.deserialize(upgraded)
	assert(Quests.uses_legacy_campaign_objectives(id) and Quests.progress(id).objectives[0].current == 3)
	var needed: float = float(Quests.objectives_for(id)[0].required)
	PlayerData.bump_stat("monsters_killed", "sootfang_fox", needed)
	assert(Quests.claim(id))
	assert(not Quests.uses_legacy_campaign_objectives(id))
	assert(not Quests.claim(id))
	GameManager.start_new_game("standard")
	assert(not Quests.uses_legacy_campaign_objectives(id))
	PlayerData.bump_stat("monsters_killed", "sootfang_fox", 3)
	Quests.deserialize({"accepted": {}, "claimed": {}})
	assert(Quests.uses_legacy_campaign_objectives(id))
	assert(Quests.progress(id).objectives[0].current == 3)
	GameManager.start_new_game("standard")
	PlayerData.set_level("wayfolding", 5)
	assert(SkillManager.start_action("wayfolding", "survey_marshway"))
	SkillManager.tick(30.0)
	assert(Quests.progress("reedwrack_restore_4").objectives[0].current > 0.0)
	SkillManager.stop_action(SkillManager.StopReason.PLAYER)
	print("RESTORATION UNIQUE CHECK PASS")
	get_tree().quit()
