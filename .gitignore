# Root-level files stay local, except the README. Folders are not affected (the trailing-slash
# rule re-includes every directory). project.godot and .gitignore are kept because the repo
# cannot be opened in Godot, or keep these rules, without them.
/*
!/*/
!/README.md
!/project.godot
!/.gitignore


.godot/
.superpowers/
.worktrees/
shots/
.shot_gate/
*.tmp

# Godot export output. Rebuildable from a checkout, and the .exe alone is 98MB — over
# GitHub's 100MB per-file ceiling, so a stray export breaks the push outright.
*.exe
*.pck
*.dll
*.zip
*.apk
*.aab
export_presets.cfg

# Python bytecode from the tools/ audit scripts.
__pycache__/
*.pyc

# Local before/after screenshots from the UI gate tool. 9MB of PNGs that only matter to
# whoever ran the gate on this machine.
tools/shot_baseline/
tools/skills_audit/

# Generated by gen_assets_manifest.py — the script is tracked, its output is not. A stale
# manifest that disagrees with the real tree is worse than no manifest.
asset_manifest.csv
asset_manifest.*.translation
ASSET_MANIFEST.html

# Internal engineering reports. Useful in a working copy, noise in a public repo: these
# record what was WRONG at a point in time, not how the game works now.
BALANCE_REPORT.md
VALIDATION_REPORT.md
IMPLEMENTATION_ROADMAP.md
IMPLEMENTATION_CHECKLIST.md
assets/ASSET_STATUS.md

# Agent scratch: implementation plans and specs for the AI tooling that wrote this code.
# Not game content, and nobody cloning the game needs them.
docs/superpowers/
.unlazy/

# Editor plugins and the MCP bridge. Dev tooling, not game code: project.godot no longer
# registers them, so a checkout runs without them.
addons/

# Offline asset/manifest generators. The game's own checks are the Godot flags in §1
# (--smoke, --tests, --selftest) and need no Python. Kept on disk, just not in the repo.
*.py
*.pyc

# Design artefacts from authoring the art, not art the game loads.
ui_kit_contact_sheet.png*
tab_check.png*
assets/architecture.png*



# Notes and logs anywhere in the tree, except the README.
*.md
!/README.md
*.log

# Local-only docs and tooling
docs/superpowers/specs/
tools/
ART_REQUESTS.md
